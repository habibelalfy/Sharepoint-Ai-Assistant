# ──────────────────────────────────────────────────────────────────────────────
# SharePoint AI Project Management Assistant — environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`
# (it is ignored via .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── SharePoint On-Premises Connection ────────────────────────────────────────
# Base URL of the project site (SharePoint Server 2019).
SHAREPOINT_SITE_URL=http://sp-server/sites/projects
# Service account used for SharePoint REST API calls (Kerberos/SPNEGO).
SHAREPOINT_USERNAME=svc_ai_assistant
SHAREPOINT_PASSWORD=changeme
# AD domain (Kerberos realm) for the service account.
SHAREPOINT_DOMAIN=CORP
# Authentication mode: "kerberos" (primary) | "ntlm" (fallback).
SHAREPOINT_AUTH_MODE=kerberos
# Kerberos (SPNEGO) requires the Node process to run under a domain account or
# present a keytab/SPN for the SharePoint HTTP service — wired in Phase 1.

# ── Logging ──────────────────────────────────────────────────────────────────
# pino log level: fatal | error | warn | info | debug | trace.
LOG_LEVEL=info

# ── Scheduled Alerts (cron expressions, node-cron) ───────────────────────────
# Overdue tasks/milestones check — daily at 09:00.
ALERT_SCHEDULE_OVERDUE=0 9 * * *
# Upcoming milestones check — daily at 10:00.
ALERT_SCHEDULE_MILESTONES=0 10 * * *
# Weekly project health check — Monday at 08:00 (wired in Phase 4).
ALERT_SCHEDULE_HEALTHCHECK=0 8 * * 1

# ── Alert delivery ───────────────────────────────────────────────────────────
# Comma-separated email recipients for scheduled alerts.
ALERT_RECIPIENTS=pm@corp.com
# When SMTP_HOST is set, alerts are sent over SMTP (requires `npm i nodemailer`).
# When unset, alerts are logged to stderr instead of being sent.
# SMTP_HOST=smtp.corp.com
# SMTP_PORT=25
# SMTP_FROM=ai-assistant@corp.com

# ── HTTP Gateway (SPFx web part integration, Phase 6) ────────────────────────
HTTP_GATEWAY_PORT=3001
# Secret used to sign JWTs for SPFx web part authentication. Use a long random
# value in production; source from a vault/secret store (see Phase 7).
JWT_SIGNING_KEY=changeme
